{
  "name": "runbook",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown notes with shell cells you can run, one bash session per runbook",
  "homepage": "https://runbook.mhd.codes",
  "repository": "github:mhdcodes/runbook",
  "license": "MIT",
  "author": "MHD",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev --noSandbox",
    "start": "install-electron && electron-vite preview --noSandbox",
    "build": "pnpm typecheck && electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "typecheck": "tsc -b && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "desktopName": "runbook.desktop",
  "productName": "Runbook",
  "dependencies": {
    "electron-updater": "6.8.11",
    "markdown-it": "15.0.3",
    "minisearch": "7.2.0",
    "nanoid": "6.0.2",
    "node-pty": "1.1.0",
    "yaml": "2.9.1"
  }
}
